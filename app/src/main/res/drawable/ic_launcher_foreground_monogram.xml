    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left Pillar (Cyan) -->
    <path
        android:pathData="M35,30 v48"
        android:strokeColor="#FF35C7E8"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- Right Pillar (Purple) -->
    <path
        android:pathData="M73,30 v48"
        android:strokeColor="#FF8C6BFF"
        android:strokeWidth="8"
        android:strokeLineCap="round" />

    <!-- Center Chevron Connecting Stems -->
    <path
        android:pathData="M35,36 L54,57 L73,36"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
